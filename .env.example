# Supabase project credentials (find these in Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key, used only in server actions / route handlers that need
# elevated access (e.g. admin maintenance jobs). NEVER expose to the client,
# and note: with the personal-data RLS model, everyday app code should never
# need this key at all.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
