# Supabase project credentials (find these in Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key, used only in server actions / route handlers that need
# elevated access (e.g. admin maintenance jobs). NEVER expose to the client,
# and note: with the personal-data RLS model, everyday app code should never
# need this key at all.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (S3-compatible) -- server-only, never exposed to the browser
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Email sent by the app itself (contact form, account-deletion notice, daily digest)
# Use Brevo (no domain needed) or Resend (needs a verified domain).
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your-brevo-api-key
# RESEND_API_KEY=re_your_resend_api_key
# Must be a sender you verified in Brevo (a Gmail address works)
EMAIL_FROM=University Manager <your-verified-sender@gmail.com>
SUPPORT_EMAIL=where-you-want-support-messages@gmail.com

# Daily email digest (cron): any long random string. Vercel sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
# Your public site address (used for links inside emails), no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
